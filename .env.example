# ============================================
# PPD Assistant - Environment Configuration
# ============================================
# Copy this file to ".env" and fill in real values.
# Never commit ".env" to git.

# --- LLM (OpenRouter) ---
# Buat API key di: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Pilih model. Saran (paling reliable untuk tool calling, urutan rekomendasi):
#   anthropic/claude-sonnet-4
#   openai/gpt-4o
#   openai/gpt-4o-mini       (lebih murah, cukup untuk testing)
#   google/gemini-2.0-flash-001
PPD_MODEL=anthropic/claude-sonnet-4

# Optional: site URL & app name (untuk OpenRouter analytics)
PPD_SITE_URL=https://github.com/khadijahumar/ppd-agent
PPD_APP_NAME=PPD Assistant

# --- Telegram bot ---
# Buat bot di Telegram: chat @BotFather, perintah /newbot, ikuti instruksi.
# Setelah jadi, BotFather kasih token format "1234567890:AAEx..."
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Whitelist user_id Telegram yang boleh akses bot.
# Cara cek user_id: chat @userinfobot di Telegram.
# Format: comma-separated integers, contoh: "123456789,987654321"
# Kosongkan supaya semua user di-block (default aman).
TELEGRAM_ALLOWED_USER_IDS=

# --- Data paths (default sudah OK, ganti hanya bila perlu) ---
PPD_DATA_DIR=./data
PPD_RAW_DIR=./data/raw
PPD_PARQUET_DIR=./data/parquet
PPD_PLOTS_DIR=./data/plots

# --- Logging ---
LOG_LEVEL=INFO
